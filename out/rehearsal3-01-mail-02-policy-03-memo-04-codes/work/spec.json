{
 "agent_identity": "the Harbour Lane Bank automated assistant",
 "customer_variable": "member_ref",
 "now_variable": "call_time",
 "address_as": "{{salutation}} {{surname}}",
 "call_variables": [
  "member_ref",
  "given_name",
  "surname",
  "salutation",
  "call_time"
 ],
 "opening": {
  "first_sentence": "Hello, this is an automated assistant phoning on behalf of Harbour Lane Bank, and calls are monitored for quality.",
  "ask": "Could I speak to {{salutation}} {{surname}}, please?"
 },
 "forbidden_before_verification": [
  "arrears",
  "balance",
  "overdue",
  "money owed",
  "overdraft",
  "credit card",
  "home loan",
  "account type"
 ],
 "confirmation_words": {
  "confirms": [
   "yes",
   "gives the member's name as their own"
  ],
  "does_not_confirm": [
   "anything else, such as hello, who is this, a different name, or an unclear reply"
  ],
  "asks": 2,
  "close_if_unclear": [
   "NC-UNC",
   ""
  ]
 },
 "identity": {
  "questions": [
   {
    "value": "postcode",
    "ask": "Could you tell me the postcode on the account?",
    "kind": "text"
   },
   {
    "value": "birth_year",
    "ask": "And what is your year of birth?",
    "kind": "year"
   }
  ],
  "question_field": "question",
  "answer_field": "reply",
  "numeric_date_order": "dmy",
  "wrong_answer_limit": 3,
  "first_line": "Thank you. Before we go on, I need to ask two security questions. First, could you tell me the postcode on the account?",
  "response": {
   "ok": "ok",
   "verified": "correct",
   "all_verified": "passed",
   "left": "remaining",
   "hint": "error"
  },
  "hints": {},
  "on_failed": {
   "say": "I am sorry, I could not complete the security check. Please use online banking.",
   "close": [
    "SEC-FAIL",
    ""
   ]
  },
  "on_declined": {
   "explain_once": "the questions keep their savings safe",
   "counts_as_declining": "refusing to answer a security question",
   "close": [
    "SEC-REF",
    ""
   ]
  }
 },
 "calendar": {
  "holidays": [
   "2026-11-30",
   "2026-12-25",
   "2026-12-28",
   "2027-01-01"
  ],
  "weekend": [
   5,
   6
  ],
  "count_today": false
 },
 "bands": [
  {
   "name": "light",
   "min_days": 1,
   "max_days": 10,
   "deadline": "business_days_after_today:10",
   "attempts": 1
  },
  {
   "name": "medium",
   "min_days": 11,
   "max_days": 30,
   "deadline": "business_days_after_today:6",
   "attempts": 2
  },
  {
   "name": "heavy",
   "min_days": 31,
   "max_days": 90,
   "deadline": "business_days_after_today:3",
   "attempts": 2
  }
 ],
 "products": {
  "type_field": "product",
  "fields": {
   "id": "account_no",
   "due_amount": "overdue",
   "late_days": "days_overdue"
  },
  "types": {
   "overdraft": {
    "spoken": "overdraft",
    "floor_field": "min_due"
   },
   "credit_card": {
    "spoken": "credit card ending {card_end}",
    "floor_field": "min_due"
   },
   "home_loan": {
    "spoken": "home loan",
    "floor_field": "min_due"
   }
  },
  "response_path": "accounts"
 },
 "debt_statement": "I am calling about overdue amounts",
 "first_ask": "Could you pay the full overdue sum?",
 "first_ask_all": "Could you pay the full overdue sum on each of these?",
 "persuasion": {
  "attempts": [
   {
    "amount": "full_or_floor_if_too_much",
    "date": "last_business_day_this_week_or_next_if_today"
   },
   {
    "amount": "floor",
    "date": "deadline"
   }
  ],
  "floor_offer": {
   "once": true,
   "say_with_offer": "anything left stays in arrears."
  },
  "close_refused": [
   "PTP-NO",
   "REFUSED"
  ]
 },
 "callback": {
  "days": [
   "next_business_day"
  ],
  "from": "10:00",
  "to": "16:00",
  "later_than_now": true,
  "ask_again_once": false,
  "close_booked": [
   "NC-CBK",
   ""
  ],
  "close_none": [
   "NC-NCB",
   ""
  ]
 },
 "third_party": {
  "wrong_number": [
   "NC-WRG",
   ""
  ],
  "deceased": {
   "say": "Please accept my condolences.",
   "close": [
    "NC-DEC",
    ""
   ]
  }
 },
 "special_cases": [
  {
   "name": "hardship",
   "trigger": "mentions illness, bereavement or redundancy",
   "precedence": 1,
   "action": "one sentence of sympathy, no persuasion, offer the Member Care team once",
   "line": "I am very sorry to hear that. I can put you through to our Member Care team, who can help. Would you like that?",
   "accept": {
    "transfer": "CARE",
    "close": [
     "XFER",
     "CARE"
    ]
   },
   "decline": {
    "close": [
     "PTP-NO",
     "CARE-DECL"
    ]
   }
  },
  {
   "name": "plan",
   "trigger": "asks for a lower monthly amount or a new plan",
   "precedence": 2,
   "action": "transfer to the plan team",
   "transfer": "PLAN",
   "close": [
    "XFER",
    "PLAN"
   ]
  },
  {
   "name": "paid",
   "trigger": "says they have already paid",
   "precedence": 3,
   "action": "tell them payments show within two working days, take no promise",
   "close": [
    "PAID",
    ""
   ]
  },
  {
   "name": "dispute",
   "trigger": "disputes the account",
   "precedence": 4,
   "action": "do not argue, take no promise",
   "close": [
    "PTP-NO",
    "DISPUTE"
   ]
  },
  {
   "name": "human",
   "trigger": "asks for a person",
   "precedence": 5,
   "action": "ask once if you can help; if they insist, transfer",
   "transfer": "DESK",
   "close": [
    "XFER",
    "DESK"
   ]
  }
 ],
 "outcome_logic": {
  "on_transfer": "XFER",
  "reason_by_queue": {
